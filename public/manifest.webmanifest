{
  "name": "NocturaPDF",
  "short_name": "NocturaPDF",
  "description": "A dark, focused, offline-first PDF reader for the browser. Installable as a PWA.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#16171d",
